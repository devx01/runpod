# Where this pod's tunnel agent dials in (the gateway's /tunnel; wss:// for a real gateway behind TLS)
GATEWAY_TUNNEL_URL=ws://127.0.0.1:8090/tunnel
# The gateway's static tunnel key (sample). The real one comes from the pod's environment (RunPod secret), never a file.
TUNNEL_KEY=fake-tunnel-key
# Optional: the pod id the gateway shows (default: inference / training)
# POD_ID=training-job-0007
# The service keys the gateway sends; the fake services check them
DETECTOR_KEY=fake-detector-key
TRAINER_KEY=fake-trainer-key
HF_TOKEN=